{
  "permissions": {
    "allow": [
      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./*.md)",
      "Read(./pyproject.toml)",
      "Bash(uv run:*)",
      "Bash(uv sync)",
      "Bash(claude auth status:*)"
    ],
    "deny": [
      "Read(./**/.credentials.json)",
      "Read(./**/.env)",
      "Bash(uv add:*)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_reads.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_turn_cap_guard.py\" --hook"
          }
        ]
      }
    ]
  }
}
